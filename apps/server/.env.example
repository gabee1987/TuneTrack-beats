NODE_ENV=development
PORT=3001
# Vite uses HTTPS in local dev (basicSsl). Development CORS also allows LAN origins.
CLIENT_ORIGIN=https://localhost:5173

# Non-empty values in this file override Windows User/Machine environment variables.
# Get these from https://developer.spotify.com/dashboard (your app → Settings).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must match an allowed Redirect URI in the Spotify app settings (exact match):
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3001/api/spotify/callback
