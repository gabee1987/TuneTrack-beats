NODE_ENV=development
PORT=3001
# Vite uses HTTPS in local dev (basicSsl). Development CORS also allows 127.0.0.1 and LAN origins.
# Spotify OAuth (since 27 Nov 2025) rejects `localhost` redirect URIs, so browse the app via
# https://127.0.0.1:5173 (desktop) or https://YOUR-LAN-IP:5173 (phone) when using Spotify login.
CLIENT_ORIGIN=https://127.0.0.1:5173

# Non-empty values in this file override Windows User/Machine environment variables.
# Get these from https://developer.spotify.com/dashboard (your app → Settings).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Comma-separated. Must match Redirect URIs in the Spotify app settings (exact match).
# Spotify OAuth rules (enforced 27 Nov 2025): `localhost` aliases are NOT allowed; use the
# loopback IP 127.0.0.1 instead. Non-loopback URIs must be HTTPS (http is only allowed on 127.0.0.1).
# - http://127.0.0.1:3001/... → PC-only callback that hits the Node server directly
# - https://127.0.0.1:5173/... → PC via Vite HTTPS proxy (browse the app at https://127.0.0.1:5173)
# - https://YOUR-LAN-IP:5173/... → phone on Wi‑Fi via Vite HTTPS proxy (required for phone login)
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3001/api/spotify/callback,https://127.0.0.1:5173/api/spotify/callback

# Audit → console (+ Axiom when AXIOM_* is set). Spotify auth audits also go to Axiom
# whenever AXIOM_TOKEN + AXIOM_DATASET are set, even if this is false.
ENABLE_EVENT_AUDIT=true
LOG_LEVEL=debug
# TEST_RUN_ID=local-dev

# Optional Axiom ingest (local or Railway). Both required together:
# AXIOM_TOKEN=
# AXIOM_DATASET=tunetrack-server
# AXIOM_DOMAIN=https://eu-central-1.aws.edge.axiom.co
