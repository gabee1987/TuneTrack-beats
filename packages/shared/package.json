{
  "name": "@tunetrack/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./dist/client.js"
    },
    "./constants": {
      "types": "./src/constants/gameplay.ts",
      "default": "./dist/constants/gameplay.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --pool=threads --passWithNoTests",
    "test:coverage": "vitest run --pool=threads --passWithNoTests --coverage"
  },
  "dependencies": {
    "zod": "^3.23.8"
  }
}
